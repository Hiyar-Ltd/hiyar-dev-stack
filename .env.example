# Hiyar local dev environment variables
# Copy to .env and customise. Never commit .env.
#
# These match the ports exposed by compose.yaml.
# Service code reads these at startup; tests call t.Setenv() directly
# from the endpoint structs returned by hiyar-go-testutils helpers.

# Default profile — starts everything. Override per-run with --profile minimal etc.
COMPOSE_PROFILES=full

# PostgreSQL
POSTGRES_DSN=postgres://hiyar:hiyar@localhost:5432/hiyar?sslmode=disable

# Per-service DSNs (role-per-service, mirrors production IAM)
USER_SERVICE_DSN=postgres://user_svc:user_svc@localhost:5432/hiyar?sslmode=disable
LISTING_SERVICE_DSN=postgres://listing_svc:listing_svc@localhost:5432/hiyar?sslmode=disable
SEARCH_SERVICE_DSN=postgres://search_svc:search_svc@localhost:5432/hiyar?sslmode=disable
BOOKING_SERVICE_DSN=postgres://booking_svc:booking_svc@localhost:5432/hiyar?sslmode=disable
PAYMENT_SERVICE_DSN=postgres://payment_svc:payment_svc@localhost:5432/hiyar?sslmode=disable
HANDOVER_SERVICE_DSN=postgres://handover_svc:handover_svc@localhost:5432/hiyar?sslmode=disable
REVIEW_SERVICE_DSN=postgres://review_svc:review_svc@localhost:5432/hiyar?sslmode=disable
RISK_SERVICE_DSN=postgres://risk_svc:risk_svc@localhost:5432/hiyar?sslmode=disable
AI_SERVICE_DSN=postgres://ai_svc:ai_svc@localhost:5432/hiyar?sslmode=disable

# Redis
REDIS_URL=redis://localhost:6379

# Cloud Pub/Sub emulator
PUBSUB_EMULATOR_HOST=localhost:8085
PUBSUB_PROJECT_ID=hiyar-local

# Cloud Firestore emulator
FIRESTORE_EMULATOR_HOST=localhost:8088
FIRESTORE_PROJECT_ID=hiyar-local

# Cloud Storage (fake-gcs-server)
STORAGE_EMULATOR_HOST=http://localhost:4443
GCS_PROJECT_ID=hiyar-local

# Temporal
TEMPORAL_ADDRESS=localhost:7233
TEMPORAL_NAMESPACE=default

# Stripe Mock
STRIPE_BASE_URL=http://localhost:12111
STRIPE_SECRET_KEY=sk_test_anyvalue

# Firebase Auth emulator
FIREBASE_AUTH_EMULATOR_HOST=localhost:9099
FIREBASE_PROJECT_ID=hiyar-local

# OpenTelemetry
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
OTEL_SERVICE_NAME=hiyar-local

# Postmark (use sandbox API key from Postmark dashboard — no mock needed)
POSTMARK_SERVER_TOKEN=POSTMARK_API_TEST
POSTMARK_FROM_EMAIL=noreply@hiyar.com.au
